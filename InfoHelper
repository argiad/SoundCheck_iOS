    func urlSession(_ session: URLSession, dataTask: URLSessionDataTask, didReceive data: Data) {
        if (200..<300 ~= ((dataTask.response as? HTTPURLResponse)?.statusCode ?? -1) ){
            switch (dataTask.state) {
            case URLSessionTask.State.running:
                delegate?.didReceive(data)
            case URLSessionTask.State.completed:
                activeTask = nil
                printLog("Session Compleated")
            case URLSessionTask.State.canceling:
                activeTask = nil
                printLog("^^^^^ SESSION CANCELED ^^^^^^^")
            default:
                break
            }
        } else {
            printLog(String(describing: dataTask.response))
            
        }
    }
    
